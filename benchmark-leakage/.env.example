# ---------------------------------------------------------------------------
# .env.example
# ------------
# Shared template for all four kd-leakage-* variant folders.
#
# IMPORTANT — where the copy goes: run_pipeline.sh and eval.sh cd into their
# own variant folder and load ./.env from there. So the .env must live in the
# variant folder you are running, not next to this template:
#
#   cd kd-leakage-arc && cp ../.env.example .env
#
# NOTHING HERE IS REQUIRED to reproduce the ARC experiments. The pipeline
# trains, saves and evaluates entirely on local disk with no credentials at
# all. These variables only enable optional conveniences.
#
# EXCEPTION — the GPQA variants (kd-leakage-gpqa, kd-leakage-gpqa-gemma): GPQA
# is a GATED dataset, so those two do need Hub authentication before step 1 and
# before eval.sh. Accept the dataset terms on the Hub and run
# `huggingface-cli login` (or set HF_TOKEN below).
#
# Do NOT commit your filled-in .env — it is listed in .gitignore.
# ---------------------------------------------------------------------------

# --- Hugging Face -----------------------------------------------------------
# Namespace used when pushing artifacts to the Hub, and when resolving a model
# that has no local checkpoint (e.g. re-running eval.sh on a fresh machine).
# Leave unset to stay fully local.
HF_USERNAME=

# Required only for: (a) pushing to the Hub, and (b) the GPQA variants, since
# GPQA is a gated dataset. `huggingface-cli login` writes the same credential,
# so you usually do not need this here.
# HF_TOKEN=

# Where the Hub caches downloaded models and datasets. Defaults to
# ~/.cache/huggingface. Point this at a large volume — the base models and the
# top-K logit dumps are tens of GB.
# HF_HOME=/path/to/large/volume/huggingface

# --- Environment ------------------------------------------------------------
# If this project lives in a dedicated conda env, name it here and the shell
# scripts will activate it. Leave unset to use whatever python is on PATH.
# KD_CONDA_ENV=kd-leakage

# --- Evaluation -------------------------------------------------------------
# Override the tokenizer whose chat template the custom lm-eval tasks use for
# scoring. Defaults to the base model of the variant you are running; only
# change it if you are scoring a different model in the same family.
# EVAL_TOKENIZER=

# lm-eval batch size. "auto" lets the harness size it per model.
# EVAL_BATCH=32
